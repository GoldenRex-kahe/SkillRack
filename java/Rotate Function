class Solution {
    public int maxRotateFunction(int[] nums) {
        int n = nums.length;
        long totalSum = 0;
        long currentValue = 0;

        for (int i = 0; i < n; i++) {
            totalSum += nums[i];
            currentValue += (long) i * nums[i];
        }

        long maximum = currentValue;

        for (int k = 1; k < n; k++) {
            currentValue = currentValue
                    + totalSum
                    - (long) n * nums[n - k];

            maximum = Math.max(maximum, currentValue);
        }

        return (int) maximum;
    }
}
